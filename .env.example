# Copy to .env and fill in, or use the in-app Settings page (key 9). Never commit your real .env.

# Order in which data sources are tried. Comma-separated list of: tradier, cboe, yahoo
#   tradier: real-time with a Tradier API token (sandbox tokens are delayed)
#   cboe:    free Cboe delayed quotes (~15 minutes), no account needed
#   yahoo:   free Yahoo Finance (delayed)
OPTION_TRADER_PROVIDERS=tradier,cboe,yahoo

# Tradier API token (Tradier dashboard -> API Access). Set TRADIER_SANDBOX=1 for a sandbox token.
TRADIER_TOKEN=
TRADIER_SANDBOX=0

# Stream real-time ticks from Tradier when a production token is set (1 = on, 0 = off)
OPTION_TRADER_LIVE_TICKS=1

# Fallback annual risk-free rate (0.04 = 4%) if the Treasury yield curve can't be fetched
OPTION_TRADER_RISK_FREE_RATE=0.04

# Seconds an option chain stays cached before it is fetched again
OPTION_TRADER_CACHE_TTL=30

# During market hours, prices older than this (seconds) make the app try the next source
OPTION_TRADER_STALE_SECONDS=180

# Where saved strategies, settings and the portfolio are stored (defaults to ~/.option_trader)
# OPTION_TRADER_DATA_DIR=

# Trading fees used for net P&L (blank = default). Commission is your broker's; the rest are
# regulatory fees every US broker passes through.
# OPTION_TRADER_COMMISSION_PER_CONTRACT=0.65
# OPTION_TRADER_COMMISSION_PER_ORDER=0
# OPTION_TRADER_ORF=0.0229
# OPTION_TRADER_OCC_FEE=0.02
# OPTION_TRADER_FINRA_TAF=0.00279
# OPTION_TRADER_SEC_FEE=0.0000278
