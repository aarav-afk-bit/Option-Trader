# Copy to .env and fill in. Never commit your real .env.

# Order in which data sources are tried for the option chain.
# Comma-separated list of: nse, angelone, yahoo
OPTION_TRADER_PROVIDERS=nse,angelone,yahoo

# Annual risk-free rate used for Black-Scholes (0.065 = 6.5%, roughly the Indian 91-day T-bill)
OPTION_TRADER_RISK_FREE_RATE=0.065

# Seconds an option chain stays cached before it is fetched again
OPTION_TRADER_CACHE_TTL=30

# Where saved strategies are stored (defaults to ~/.option_trader)
# OPTION_TRADER_DATA_DIR=

# Angel One SmartAPI credentials (https://smartapi.angelbroking.com/)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# Base32 secret shown when you enable TOTP for SmartAPI
ANGEL_TOTP_SECRET=

# Stream real-time exchange ticks from Angel One's WebSocket feed when the credentials above
# are set (1 = on, 0 = off). This is what makes premiums update tick by tick.
OPTION_TRADER_LIVE_TICKS=1
